# Server-only values; configure these in the hosting environment, never browser JS.
# Generate a random secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ACCESS_REQUEST_WEBHOOK_SECRET=
# Choose brevo (reuse your existing email service) or resend.
REGISTRATION_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Only required when REGISTRATION_EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# A sender verified in the selected email provider.
REGISTRATION_EMAIL_FROM=
